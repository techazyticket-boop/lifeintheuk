# Supabase (Frontend — exposed to browser via Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (Frontend — price IDs are safe to expose)
VITE_STRIPE_PRICE_WEEKLY=price_your_weekly_price_id
VITE_STRIPE_PRICE_MONTHLY=price_your_monthly_price_id

# For Netlify Functions (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Server-side — NEVER expose these)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
